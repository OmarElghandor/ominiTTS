# HuggingFace model ID (bootstrap script only — not used at API runtime)
MODEL_NAME=mohammedaly22/VoiceTut-TTS

# Container path to pre-seeded weights — must match the volume mount target
# Pod/compose default: /data/omnivoice-model
# Serverless Network Volume: /runpod-volume/omnivoice-model
MODEL_STORE_DIR=/data/omnivoice-model

# Host path for RunPod Pod Network Volume bind mount (compose-time only, not read by the app)
OMNIVOICE_VOLUME_HOST_PATH=/workspace/omnivoice-model

# Inference device: cuda:0 on GPU hosts (RunPod prod); set cpu for CPU-only testing
DEVICE=cuda:0

# Optional dtype override (auto: float16 on GPU, float32 on CPU)
# DTYPE=float32

# Offline mode — must stay 1 in production (blocks live HF downloads)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Max input text length (characters)
MAX_TEXT_LENGTH=500

# SpeechEngine concurrency / queue
MAX_CONCURRENT_REQUESTS=1
MAX_QUEUE_SIZE=8
REQUEST_TIMEOUT=120

# Logging and output
LOG_LEVEL=INFO
OUTPUT_FORMAT=wav

# Provider registry key (voicetut default; omnivoice for the base k2-fsa checkpoint)
SPEECH_PROVIDER=voicetut
DEFAULT_SPEAKER=Mohamed
DEFAULT_NUM_STEP=16
WARMUP_TEXT=ازيك عامل ايه؟

# Ready marker for serverless Docker HEALTHCHECK
READY_MARKER_PATH=/tmp/omnivoice-ready

# If 1, first Serverless worker auto-downloads ~3.5 GB into MODEL_STORE_DIR when empty
# BOOTSTRAP_IF_EMPTY=1

# HTTP port (FastAPI / Pod only)
PORT=8080

# One-time bootstrap only — set to 1 to download weights instead of starting the API,
# wait for "Bootstrap complete." in logs, then remove and restart normally.
# BOOTSTRAP_ONLY=1

# CUDA_VISIBLE_DEVICES is a process env (optional), e.g. CUDA_VISIBLE_DEVICES=0
