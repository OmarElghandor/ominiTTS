# HuggingFace model ID (bootstrap script only — not used at API runtime)
MODEL_NAME=k2-fsa/OmniVoice

# Local path to pre-seeded weights — must match the Docker/Railway volume mount path
MODEL_STORE_DIR=/data/omnivoice-model

# Inference device: cuda:0 for GPU, cpu for Railway/testing
DEVICE=cpu

# Optional dtype override (auto: float16 on GPU, float32 on CPU)
# DTYPE=float32

# Offline mode — must stay 1 in production (blocks live HF downloads in the API)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Max input text length (characters)
MAX_TEXT_LENGTH=500

# HTTP port
PORT=8080

# Railway one-time bootstrap only — set to 1 in the Railway dashboard, deploy once to seed
# the volume, then remove and redeploy. Do not leave enabled during normal API operation.
# BOOTSTRAP_ONLY=1
