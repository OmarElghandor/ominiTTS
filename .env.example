# HuggingFace model ID (bootstrap script only — not used at API runtime)
MODEL_NAME=k2-fsa/OmniVoice

# Container path to pre-seeded weights — must match the docker-compose volume mount target
MODEL_STORE_DIR=/data/omnivoice-model

# Host path for RunPod Network Volume bind mount (compose-time only, not read by the app)
OMNIVOICE_VOLUME_HOST_PATH=/workspace/omnivoice-model

# Inference device: cuda:0 on GPU hosts (RunPod prod); set cpu for CPU-only testing
DEVICE=cuda:0

# Optional dtype override (auto: float16 on GPU, float32 on CPU)
# DTYPE=float32

# Offline mode — must stay 1 in production (blocks live HF downloads in the API)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Max input text length (characters)
MAX_TEXT_LENGTH=500

# HTTP port
PORT=8080

# One-time bootstrap only — set to 1 to download weights instead of starting the API,
# wait for "Bootstrap complete." in logs, then remove and restart normally.
# BOOTSTRAP_ONLY=1
