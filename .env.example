# HuggingFace model ID
MODEL_NAME=k2-fsa/OmniVoice

# Inference device: cuda:0 for GPU, cpu for Railway/testing
DEVICE=cpu

# Optional dtype override (auto: float16 on GPU, float32 on CPU)
# DTYPE=float32

# Model cache directory — must match the Docker/Railway volume mount path
HF_HOME=/data/huggingface

# Max input text length (characters)
MAX_TEXT_LENGTH=500

# HTTP port
PORT=8080
